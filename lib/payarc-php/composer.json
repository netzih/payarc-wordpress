{
  "name": "chabadrichmond/payarc-php",
  "description": "Framework-free PayArc API v1 client: Hosted Fields token and saved-card charges, void/refund, reconciliation and donor-facing error wording",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "Payarc\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Payarc\\Tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.1.0" },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
